# root .gitignore
# Ignore all loose files in the root folder
/*
# But don't ignore these directories/files
!/.gitignore
!/.gitattributes
!/README.md
!/client/
!/.vscode/

# Explicitly ignore these directories
/app/
/server/
/supabase/
client_secret_*.json

/flutter_app/
/save/
/temp_preserved/
/temp_search/
/temp_search_oldest/
/stitch_export/

# Global Ignore Patterns
node_modules/
*.zip
*.apk
*.log
.env
*.env
.env.*local
.DS_Store

# Build outputs
dist/
client/dist/
server/dist/
save/dist/
client/.vite/
dist-ssr/
coverage/

# Env & secrets
.env
*.env
.env.*local
client/.env*
server/.env*
save/.env*

# OS / editor
/.vscode
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Backend data
server/dump.rdb
server/temp-*.rdb
server/redis_bin/
server/redis_data/
server/storage/uploads/

# Project-specific
save/
.vercel/

# Mobile / Capacitor (Exclude build junk, keep config)
**/local.properties
**/build/
**/capacitor-cordova-android-plugins/
**/.gradle/

# Agentic / Temp search artifacts
temp_preserved/
temp_search/
temp_search_oldest/
.antigravityignore

# Large local documents (avoid long path issues)
**/*.mp4
**/*.backup.mp4
**/*.apk
client/src/assets/*.docx
client/src/assets/*.doc
client/src/assets/*.rtf
client/src/assets/*.xlsx
